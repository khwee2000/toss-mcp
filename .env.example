# ---------------------------------------------------------------------------
# Toss Trader MCP — environment template.  Copy to `.env` and fill in.
#   cp .env.example .env  &&  chmod 600 .env
# NEVER commit `.env`. NEVER print TOSS_CLIENT_SECRET anywhere.
# With NO key set, the server runs in safe MOCK mode automatically.
# ---------------------------------------------------------------------------

# --- BYOK credentials (server env only; leave blank to stay in mock) --------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# --- Mode flags -------------------------------------------------------------
# Use a LIVE network transport. Requires a valid TOSS_CLIENT_SECRET.
# Default (unset/0) = MOCK.
TOSS_LIVE=0

# Allow order (write) tools to be REGISTERED and to hit the network.
# Default (unset/0) = read-only: write tools are not even registered.
TOSS_ALLOW_LIVE_ORDERS=0

# Global kill switch. If 1: force MOCK + reject every order POST.
# Re-checked immediately before every order, so you can flip it without restart.
TOSS_KILL=
#
# File kill-switch (inv 9a): create an empty file named HALT to block ALL orders
# without touching env — checked at every order POST, no restart needed:
#     touch ~/.toss-mcp/HALT          # or   touch "$TOSS_DATA_DIR/HALT"
# Delete the file to resume trading.

# --- Order safety limits (invariant 8 — conservative defaults) --------------
# Per-order notional ceiling in KRW; an order above this HARD-fails. Default 1,000,000.
# TOSS_MAX_ORDER_KRW=1000000
# Cumulative DAILY notional ceiling in KRW. Default 3,000,000.
# TOSS_MAX_DAILY_KRW=3000000
# Cumulative DAILY order-count ceiling. Default 20.
# TOSS_MAX_DAILY_COUNT=20

# --- Token at-rest (invariant 13A) ------------------------------------------
# Persist the OAuth token to token.json (written 0600, atomically, symlink-checked).
# Default (unset) = MEMORY-ONLY (recommended): no token is ever written to disk.
# Set to 1 only if you specifically want token reuse across restarts.
# TOSS_TOKEN_PERSIST=

# --- Misc -------------------------------------------------------------------
# Default account index when you have multiple accounts (연금/ISA 등).
TOSS_ACCOUNT_INDEX=0

# Override the API base URL (normally leave as the default).
# TOSS_BASE_URL=https://openapi.tossinvest.com

# Where token.json / preview.json are cached (created 0600).
# TOSS_DATA_DIR=~/.toss-trader

# Reuse the existing watchlist (200 symbols) from the dashboard project.
# STOCK_DASHBOARD_DIR=~/stock-dashboard
